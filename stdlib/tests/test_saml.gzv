// stdlib saml tests: run with `toto test` from stdlib/.
//
// Sequential (no `go`): structural parse + validation on
// fixtures, signed-refusal, and every loud error. Fixtures
// are unsigned (full validation) or carry placeholder
// signatures (refused) — NO keys are committed anywhere.
import "gzv.std/saml.gzv";

fn check(cond: bool, msg: string) -> Result<bool, string> {
    if cond {
        return Ok(true);
    } else {
        return Err(msg);
    }
}

