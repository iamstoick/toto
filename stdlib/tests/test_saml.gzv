fn t_unsigned_validates() -> Result<bool, string> {
    let a = saml_parse_response(unsigned_b64())?;
    check(a.issuer == "https://idp.toto.test/metadata", "issuer")?;
    check(a.subject == "alice@toto.test", "subject")?;
    check(a.name_format == "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress", "nameid format")?;
    check(a.session_index == "sess-42", "session")?;
    check(a.not_before == "2026-11-22T07:55:00Z", "notbefore")?;
    check(a.not_on_or_after == "2026-11-22T08:05:00Z", "notonorafter")?;
    check(a.audience == "https://sp.toto.test/metadata", "audience")?;
    check(!a.signed, "unsigned flag")?;
    check(len(a.attrs) == 2, "two attrs")?;
    check(a.attrs[0].name == "uid" && a.attrs[0].values[0] == "alice", "uid attr")?;
    check(a.attrs[1].name == "groups" && len(a.attrs[1].values) == 2, "groups attr")?;
    let ok = saml_validate(a, "2026-11-22T08:00:00Z", "https://sp.toto.test/metadata")?;
    check(ok == "alice@toto.test", "subject out")?;
    return Ok(true);
}

fn t_window_and_audience() -> Result<bool, string> {
    let a = saml_parse_response(unsigned_b64())?;
    let early = saml_validate(a, "2026-11-22T07:00:00Z", "https://sp.toto.test/metadata");
    let want_early: Result<string, string> = Err("bad saml (not yet valid)");
    check(early == want_early, "notbefore enforced")?;
    let late = saml_validate(a, "2026-11-22T09:00:00Z", "https://sp.toto.test/metadata");
    let want_late: Result<string, string> = Err("bad saml (expired)");
    check(late == want_late, "expiry enforced")?;
    let aud = saml_validate(a, "2026-11-22T08:00:00Z", "https://evil.test/metadata");
    let want_aud: Result<string, string> = Err("bad saml (audience mismatch)");
    check(aud == want_aud, "audience enforced")?;
    return Ok(true);
}

fn t_signed_refused() -> Result<bool, string> {
    let a = saml_parse_response(signed_b64())?;
    check(a.signed, "signed flag set")?;
    let r = saml_validate(a, "2026-11-22T08:00:00Z", "https://sp.toto.test/metadata");
    let want: Result<string, string> = Err("saml signature validation not shipped (signed responses refused)");
    check(r == want, "signed refused loudly")?;
    return Ok(true);
}

fn t_malformed() -> Result<bool, string> {
    let r1 = saml_parse_xml("<Response></Response>");
    let want1: Result<SamlAssertion, string> = Err("bad saml (no Assertion)");
    check(r1 == want1, "no assertion loud")?;
    let r2 = saml_parse_response("!!!not-base64!!!");
    let want2: Result<SamlAssertion, string> = Err("bad base64 (bad char)");
    check(r2 == want2, "bad b64 loud")?;
    let r3 = saml_parse_xml("<Response><Assertion></Assertion></Response>");
    let want3: Result<SamlAssertion, string> = Err("bad saml (no Issuer)");
    check(r3 == want3, "no issuer loud")?;
    return Ok(true);
}

fn main() -> int {
    let mut failures: int = 0;
    let yes: Result<bool, string> = Ok(true);
    if t_unsigned_validates() != yes {
        println("FAIL unsigned_validates");
        failures = failures + 1;
    } else {
    }
    if t_window_and_audience() != yes {
        println("FAIL window_and_audience");
        failures = failures + 1;
    } else {
    }
    if t_signed_refused() != yes {
        println("FAIL signed_refused");
        failures = failures + 1;
    } else {
    }
    if t_malformed() != yes {
        println("FAIL malformed");
        failures = failures + 1;
    } else {
    }
    if failures > 0 {
        println(to_string(failures) + " saml failures");
        return 1;
    } else {
    }
    return 0;
}
