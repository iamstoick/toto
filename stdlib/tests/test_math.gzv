// stdlib math tests: run with `toto test` from stdlib/.
import "gzv.std/math.gzv";

fn is_even_fn(x: int) -> bool {
    return x - (x / 2) * 2 == 0;
}

fn main() -> int {
    let mut failures: int = 0;
    if clamp_int(5, 0, 10) != 5 {
        println("FAIL clamp_int mid");
        failures = failures + 1;
    }
    if clamp_int(-3, 0, 10) != 0 {
        println("FAIL clamp_int lo");
        failures = failures + 1;
    }
    if clamp_int(99, 0, 10) != 10 {
        println("FAIL clamp_int hi");
        failures = failures + 1;
    }
    if clamp_float(1.5, 0.0, 1.0) != 1.0 {
        println("FAIL clamp_float");
        failures = failures + 1;
    }
    if pow_int(2, 10) != 1024 {
        println("FAIL pow_int");
        failures = failures + 1;
    }
    if pow_int(7, 0) != 1 {
        println("FAIL pow_int zero");
        failures = failures + 1;
    }
    if gcd(12, 18) != 6 {
        println("FAIL gcd");
        failures = failures + 1;
    }
    if gcd(0, 5) != 5 {
        println("FAIL gcd zero");
        failures = failures + 1;
    }
    if lcm(4, 6) != 12 {
        println("FAIL lcm");
        failures = failures + 1;
    }
    if lcm(0, 6) != 0 {
        println("FAIL lcm zero");
        failures = failures + 1;
    }
    if factorial(5) != 120 {
        println("FAIL factorial");
        failures = failures + 1;
    }
    if factorial(0) != 1 {
        println("FAIL factorial zero");
        failures = failures + 1;
    }
    if !(is_prime(17)) {
        println("FAIL is_prime 17");
        failures = failures + 1;
    }
    if is_prime(18) {
        println("FAIL is_prime 18");
        failures = failures + 1;
    }
    if is_prime(1) {
        println("FAIL is_prime 1");
        failures = failures + 1;
    }
    if !(is_prime(2)) {
        println("FAIL is_prime 2");
        failures = failures + 1;
    }
    if failures > 0 {
        println(to_string(failures) + " math failures");
        return 1;
    }
    return 0;
}
