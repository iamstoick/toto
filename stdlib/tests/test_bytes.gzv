// stdlib bytes tests: run with `toto test` from stdlib/.
import "gzv.std/bytes.gzv";

fn check(cond: bool, msg: string) -> Result<bool, string> {
    if cond {
        return Ok(true);
    } else {
        return Err(msg);
    }
}

fn t_b64() -> Result<bool, string> {
    // RFC 4648 §10 vectors, standard alphabet, padded.
    check(bytes_b64_encode([]) == "", "empty")?;
    check(bytes_b64_encode([102]) == "Zg==", "f")?;
    check(bytes_b64_encode([102, 111]) == "Zm8=", "fo")?;
    check(bytes_b64_encode([102, 111, 111]) == "Zm9v", "foo")?;
    check(bytes_b64_encode([102, 111, 111, 98]) == "Zm9vYg==", "foob")?;
    check(bytes_b64_encode([102, 111, 111, 98, 97]) == "Zm9vYmE=", "fooba")?;
    check(bytes_b64_encode([102, 111, 111, 98, 97, 114]) == "Zm9vYmFy", "foobar")?;
    check(bytes_b64_decode("Zm9vYmFy")? == [102, 111, 111, 98, 97, 114], "roundtrip")?;
    let empty: Array<int> = [];
    check(bytes_b64_decode("")? == empty, "empty rt")?;
    check(bytes_b64_decode("Zg==")? == [102], "pad2")?;
    check(bytes_b64_decode("Zm8=")? == [102, 111], "pad1")?;
    // Folded whitespace is skipped (transport payloads).
    check(bytes_b64_decode("Zm9v\nYmFy")? == [102, 111, 111, 98, 97, 114], "folded")?;
    let want_trail: Result<Array<int>, string> = Err("bad base64 (trailing data after padding)");
    check(bytes_b64_decode("Zm9v=Yg==") == want_trail, "trailing loud")?;
    let want_char: Result<Array<int>, string> = Err("bad base64 (bad char)");
    check(bytes_b64_decode("Zm9v*YmFy") == want_char, "bad char loud")?;
    check(bytes_b64_decode("Zg===") == want_trail, "triple pad loud")?;
    let want_len: Result<Array<int>, string> = Err("bad base64 (bad length)");
    check(bytes_b64_decode("A") == want_len, "bad length loud")?;
    return Ok(true);
}

fn t_b64url() -> Result<bool, string> {
    // JWT style: unpadded, `-_` alphabet.
    check(bytes_b64url_encode([102, 111, 111, 98, 97, 114]) == "Zm9vYmFy", "foobar")?;
    check(bytes_b64url_encode([255, 254]) == "__4", "urlchars")?;
    check(bytes_b64url_encode([]) == "", "empty")?;
    check(bytes_b64url_decode("Zm9vYmFy")? == [102, 111, 111, 98, 97, 114], "rt")?;
    check(bytes_b64url_decode("__4")? == [255, 254], "urlchars rt")?;
    let empty: Array<int> = [];
    check(bytes_b64url_decode("")? == empty, "empty rt")?;
    let want_pad: Result<Array<int>, string> = Err("bad base64url (padding rejected)");
    check(bytes_b64url_decode("Zm9v=") == want_pad, "padding loud")?;
    let want_len: Result<Array<int>, string> = Err("bad base64url (bad length)");
    check(bytes_b64url_decode("A") == want_len, "bad length loud")?;
    let want_char: Result<Array<int>, string> = Err("bad base64url (bad char)");
    check(bytes_b64url_decode("++==") == want_char, "std alphabet loud")?;
    return Ok(true);
}

fn t_hex() -> Result<bool, string> {
    check(bytes_hex_encode([222, 173, 190, 239]) == "deadbeef", "encode")?;
    check(bytes_hex_encode([]) == "", "empty")?;
    check(bytes_hex_decode("deadbeef")? == [222, 173, 190, 239], "rt")?;
    check(bytes_hex_decode("DEADBEEF")? == [222, 173, 190, 239], "upper")?;
    let empty: Array<int> = [];
    check(bytes_hex_decode("")? == empty, "empty rt")?;
    let want_odd: Result<Array<int>, string> = Err("bad hex (odd length)");
    check(bytes_hex_decode("abc") == want_odd, "odd loud")?;
    let want_digit: Result<Array<int>, string> = Err("bad hex (non-hex digit)");
    check(bytes_hex_decode("zz") == want_digit, "nonhex loud")?;
    return Ok(true);
}

fn t_slice() -> Result<bool, string> {
    check(bytes_slice([10, 20, 30, 40], 1, 3) == [20, 30], "mid")?;
    check(bytes_slice([10, 20, 30], 0, 3) == [10, 20, 30], "all")?;
    let empty: Array<int> = [];
    check(bytes_slice([10, 20, 30], 2, 2) == empty, "empty")?;
    check(bytes_concat([1, 2], [3, 4]) == [1, 2, 3, 4], "concat")?;
    check(bytes_concat(empty, [9]) == [9], "concat empty")?;
    check(bytes_is_valid([0, 255]), "edges")?;
    check(!bytes_is_valid([256]), "hi")?;
    check(!bytes_is_valid([-1]), "lo")?;
    check(bytes_is_valid(empty), "empty valid")?;
    return Ok(true);
}

fn t_pack() -> Result<bool, string> {
    check(bytes_u16le([52, 18], 0) == 4660, "u16le")?;
    check(bytes_u16be([18, 52], 0) == 4660, "u16be")?;
    check(bytes_u32le([120, 86, 52, 18], 0) == 305419896, "u32le")?;
    check(bytes_u32be([18, 52, 86, 120], 0) == 305419896, "u32be")?;
    check(bytes_u16le_bytes(0)? == [0, 0], "u16le zero")?;
    check(bytes_u16be_bytes(65535)? == [255, 255], "u16be max")?;
    check(bytes_u32le_bytes(305419896)? == [120, 86, 52, 18], "u32le rt")?;
    check(bytes_u32be_bytes(4294967295)? == [255, 255, 255, 255], "u32be max")?;
    check(bytes_u32le_bytes(0)? == [0, 0, 0, 0], "u32le zero")?;
    let want16: Result<Array<int>, string> = Err("u16 out of range");
    check(bytes_u16le_bytes(65536) == want16, "u16 range loud")?;
    check(bytes_u16be_bytes(-1) == want16, "u16 negative loud")?;
    let want32: Result<Array<int>, string> = Err("u32 out of range");
    check(bytes_u32le_bytes(4294967296) == want32, "u32 range loud")?;
    // Round-trips through getters.
    check(bytes_u16le(bytes_u16le_bytes(4660)?, 0) == 4660, "u16le rt")?;
    check(bytes_u16be(bytes_u16be_bytes(4660)?, 0) == 4660, "u16be rt")?;
    check(bytes_u32le(bytes_u32le_bytes(305419896)?, 0) == 305419896, "u32le rt")?;
    check(bytes_u32be(bytes_u32be_bytes(305419896)?, 0) == 305419896, "u32be rt")?;
    return Ok(true);
}

fn main() -> int {
    let mut failures: int = 0;
    let yes: Result<bool, string> = Ok(true);
    if t_b64() != yes {
        println("FAIL b64");
        failures = failures + 1;
    } else {
    }
    if t_b64url() != yes {
        println("FAIL b64url");
        failures = failures + 1;
    } else {
    }
    if t_hex() != yes {
        println("FAIL hex");
        failures = failures + 1;
    } else {
    }
    if t_slice() != yes {
        println("FAIL slice");
        failures = failures + 1;
    } else {
    }
    if t_pack() != yes {
        println("FAIL pack");
        failures = failures + 1;
    } else {
    }
    if failures > 0 {
        println("bytes tests failed");
    }
    return failures;
}
