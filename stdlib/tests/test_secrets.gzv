// stdlib secrets tests: run with `toto test` from stdlib/.
//
// Covers env/file providers, rotation, the fail-closed cascade,
// and unknown-provider gaps. Vault runs ONLY when a dev server
// is configured (`VAULT_ADDR` + `VAULT_TOKEN`, as CI provides):
// otherwise the suite asserts the provider reports unavailable
// and fetch fails closed. No credential is committed anywhere —
// every secret value here is a placeholder or ambient (PATH).
import "gzv.std/config.gzv";
import "gzv.std/secrets.gzv";

fn check(cond: bool, msg: string) -> Result<bool, string> {
    if cond {
        return Ok(true);
    } else {
    }
    return Err(msg);
}

fn t_env_provider() -> Result<bool, string> {
    // PATH is ambient on every supported platform.
    check(secrets_fetch("env", "PATH")? == config_env_get("PATH"), "env path")?;
    let r = secret_ref("env", "PATH");
    check(secrets_fetch_ref(r)? == config_env_get("PATH"), "ref path")?;
    let missing = secrets_fetch("env", "TOTO_WAVE3_DEFINITELY_UNSET_XYZ");
    let want: Result<string, string> = Err("env secret not set: TOTO_WAVE3_DEFINITELY_UNSET_XYZ");
    check(missing == want, "env missing")?;
    // Rotation is refused: env is not a store.
    let rot = secrets_rotate("env", "PATH", "x");
    let want_rot: Result<string, string> = Err("env secrets cannot be rotated (not a store)");
    check(rot == want_rot, "env rotate refused")?;
    return Ok(true);
}

// NOTE (Wave 3 fix-forward): file fixtures live under $TMPDIR (else
// /tmp) — never under `target/`. There is no mkdir builtin, and the
// `stdlib/target/` dir the first version relied on was stale local
// residue (absent on a fresh checkout, so CI failed the writes).
fn scratch_path(name: string) -> string {
    let dir = config_env_get("TMPDIR");
    if dir == "" {
        return "/tmp/" + name;
    } else {
    }
    return dir + "/" + name;
}

fn t_file_provider() -> Result<bool, string> {
    let path = scratch_path("secrets_test_value.txt");
    write_file(path, "placeholder-alpha");
    check(secrets_fetch("file", path)? == "placeholder-alpha", "file fetch")?;
    // Rotation rewrites the file and reports the `file` stamp.
    check(secrets_rotate("file", path, "placeholder-beta")? == "file", "rotate stamp")?;
    check(secrets_fetch("file", path)? == "placeholder-beta", "rotated value")?;
    check(read_file(path) == "placeholder-beta", "file rewritten")?;
    let no_such = scratch_path("TOTO_WAVE3_NO_SUCH_SECRET.txt");
    let missing = secrets_fetch("file", no_such);
    let want: Result<string, string> = Err("secret file missing: " + no_such);
    check(missing == want, "file missing")?;
    return Ok(true);
}

fn t_cascade() -> Result<bool, string> {
    // Vault unconfigured here -> skipped; env PATH wins.
    let refs: Array<SecretRef> = [secret_ref("vault", "secret/svc#value"), secret_ref("env", "PATH")];
    if secrets_is_available("vault") {
        // Dev server configured: seed a dedicated cascade key,
        // then prove the vault source wins over env (fail-closed
        // ordering — the fetch runs for real, no silent skip).
        check(secrets_rotate("vault", "secret/ci-cascade#value", "cascade-one")? != "", "seed cascade key")?;
        let vrefs: Array<SecretRef> = [secret_ref("vault", "secret/ci-cascade#value"), secret_ref("env", "PATH")];
        check(secrets_fetch_first(vrefs)? == "cascade-one", "vault wins cascade")?;
        return Ok(true);
    } else {
    }
    check(secrets_fetch_first(refs)? == config_env_get("PATH"), "cascade to env")?;
    // Nothing configured anywhere: Err names every tried ref.
    let unset_b = scratch_path("TOTO_WAVE3_UNSET_B.txt");
    let none: Array<SecretRef> = [secret_ref("env", "TOTO_WAVE3_UNSET_A"), secret_ref("file", unset_b), secret_ref("aws", "x")];
    let r2 = secrets_fetch_first(none);
    let want2: Result<string, string> = Err("no secret configured (tried env:TOTO_WAVE3_UNSET_A, file:" + unset_b + ", aws:x)");
    check(r2 == want2, "cascade miss names refs")?;
    return Ok(true);
}

fn t_gaps() -> Result<bool, string> {
    // Cloud stores are an explicit gap: never available, never
    // silent.
    check(!secrets_is_available("aws"), "aws unavailable")?;
    check(!secrets_is_available("gcp"), "gcp unavailable")?;
    check(!secrets_is_available("azure"), "azure unavailable")?;
    let r = secrets_fetch("aws", "anything");
    let want: Result<string, string> = Err("unknown secrets provider: aws");
    check(r == want, "aws fetch refused")?;
    let names = secrets_providers();
    check(len(names) == 6, "six providers named")?;
    return Ok(true);
}

fn t_vault_roundtrip() -> Result<bool, string> {
    if !secrets_is_available("vault") {
        // No dev server: the closed door is the assertion.
        // Exactly one of the two env vars is missing, and the
        // fetch names which (both messages are fixed text).
        let r = secrets_fetch("vault", "secret/svc#value");
        if !config_env_has("VAULT_ADDR") {
            let want: Result<string, string> = Err("vault: VAULT_ADDR not set");
            check(r == want, "vault closed on addr")?;
        } else {
            let want: Result<string, string> = Err("vault: VAULT_TOKEN not set");
            check(r == want, "vault closed on token")?;
        }
        return Ok(true);
    } else {
    }
    // Dev server configured (CI): full fetch + rotate proof
    // against KV-v2 with placeholder values only. Starting
    // value is read, not assumed, so a previous aborted run
    // cannot break this one; the original is restored after.
    let orig = secrets_fetch("vault", "secret/ci-only#value")?;
    let mut other: string = "placeholder-two";
    if orig == "placeholder-two" {
        other = "placeholder-one";
    } else {
    }
    let v1 = secrets_rotate("vault", "secret/ci-only#value", other)?;
    check(v1 != "", "rotate returns version")?;
    check(secrets_fetch("vault", "secret/ci-only#value")? == other, "rotated reads back")?;
    let v2 = secrets_rotate("vault", "secret/ci-only#value", orig)?;
    check(v2 != "" && v2 != v1, "version advances")?;
    check(secrets_fetch("vault", "secret/ci-only#value")? == orig, "restored")?;
    // Unknown field and bad name shape are loud (both messages
    // are fixed text: the json layer's miss, and our shape
    // check).
    let bf = secrets_fetch("vault", "secret/ci-only#TOTO_WAVE3_NO_SUCH_FIELD");
    let want_bf: Result<string, string> = Err("missing key: TOTO_WAVE3_NO_SUCH_FIELD");
    check(bf == want_bf, "bad field fails")?;
    let bs = secrets_fetch("vault", "no-slash");
    let want_bs: Result<string, string> = Err("vault name needs mount/path[#field], got: no-slash");
    check(bs == want_bs, "bad shape fails")?;
    return Ok(true);
}

fn main() -> int {
    let mut failures: int = 0;
    let yes: Result<bool, string> = Ok(true);
    if t_env_provider() != yes {
        println("FAIL env_provider");
        failures = failures + 1;
    } else {
    }
    if t_file_provider() != yes {
        println("FAIL file_provider");
        failures = failures + 1;
    } else {
    }
    if t_cascade() != yes {
        println("FAIL cascade");
        failures = failures + 1;
    } else {
    }
    if t_gaps() != yes {
        println("FAIL gaps");
        failures = failures + 1;
    } else {
    }
    if t_vault_roundtrip() != yes {
        println("FAIL vault_roundtrip");
        failures = failures + 1;
    } else {
    }
    if failures > 0 {
        println(to_string(failures) + " secrets failures");
        return 1;
    } else {
    }
    return 0;
}
