// stdlib concurrency test: stdlib helpers inside green threads.
// A two-stage pipeline (produce -> strings -> consume) proves channel
// traffic of stdlib-built values plus `toto test` on concurrent code.
import "gzv.std/strings.gzv";
import "gzv.std/collections.gzv";

fn produce(c: chan<string>) -> unit {
    let words: Array<string> = ["hello world", "foo bar", "x"];
    for w in words {
        c <- w;
    }
    close(c);
}

fn consume(c: chan<string>, out: chan<int>) -> unit {
    let mut total: int = 0;
    let mut n: int = 0;
    // Exactly three sends; the counted loop is the corpus idiom for a
    // closed channel (see conc06_fanout): no reliance on emptiness.
    while n < 3 {
        total = total + len(split(<-c, " "));
        n = n + 1;
    }
    out <- total;
    close(out);
}

fn main() -> int {
    let c = chan<string>(2);
    let out = chan<int>(1);
    go {
        produce(c);
    }
    go {
        consume(c, out);
    }
    let total: int = <-out;
    // 2 + 2 + 1 words = 5.
    if total != 5 {
        println("FAIL pipeline total: " + to_string(total));
        return 1;
    }
    if !(closed(c)) {
        println("FAIL producer closed");
        return 1;
    }
    let doubled: Array<int> = map_ints([total, 1], double_it);
    if doubled[0] != 10 {
        println("FAIL map in concurrent main");
        return 1;
    }
    return 0;
}

fn double_it(x: int) -> int {
    return x * 2;
}
