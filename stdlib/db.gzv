import "gzv.std/strings.gzv";

struct DbVal { kind: int, i: int, f: float, s: string }

unsafe extern "C" {
    fn toto_rt_db_exec(dsn: *c_char, sql: *c_char, params: *c_char) -> c_int;
    fn toto_rt_db_query(dsn: *c_char, sql: *c_char, params: *c_char) -> string;
    fn toto_rt_db_pool_config(dsn: *c_char, max: c_int, timeout_ms: c_long) -> c_int;
    fn toto_rt_db_close_pool(dsn: *c_char) -> c_int;
    fn toto_rt_db_last_error() -> string;
}

fn db_last_error() -> string {
    return toto_rt_db_last_error();
}

fn db_null() -> DbVal {
    return DbVal { kind: 0, i: 0, f: 0.0, s: "" };
}

fn db_int(n: int) -> DbVal {
    return DbVal { kind: 1, i: n, f: 0.0, s: "" };
}

fn db_float(x: float) -> DbVal {
    return DbVal { kind: 2, i: 0, f: x, s: "" };
}

fn db_text(s: string) -> DbVal {
    return DbVal { kind: 3, i: 0, f: 0.0, s: s };
}

fn db_bool(b: bool) -> DbVal {
    if b {
        return DbVal { kind: 4, i: 1, f: 0.0, s: "" };
    }
    return DbVal { kind: 4, i: 0, f: 0.0, s: "" };
}

fn db_encode_params(args: Array<DbVal>) -> string {
    let mut out: string = "P" + to_string(len(args)) + ":";
    for v in args {
        let mut payload: string = "";
        if v.kind == 1 {
            payload = to_string(v.i);
        } else if v.kind == 2 {
            payload = to_string(v.f);
        } else if v.kind == 3 {
            payload = v.s;
        } else if v.kind == 4 {
            payload = to_string(v.i);
        }
        out = out + to_string(v.kind) + "," + to_string(len(payload)) + ":" + payload + ";";
    }
    return out;
}

fn db_is_digits(s: string) -> bool {
    if len(s) == 0 {
        return false;
    }
    for c in split(s, "") {
        if c != "0" && c != "1" && c != "2" && c != "3" && c != "4" && c != "5" && c != "6" && c != "7" && c != "8" && c != "9" {
            return false;
        } else {
        }
    }
    return true;
}

fn db_parse_float(s: string) -> Result<float, string> {
    let mut neg: bool = false;
    let mut rest: string = s;
    if len(rest) > 0 && char_at(rest, 0) == "-" {
        neg = true;
        rest = substring(rest, 1, len(rest));
    }
    if rest == "NaN" || rest == "Infinity" || rest == "+Infinity" {
        return Err("non-finite float in interpreter db path (use the runtime engine)");
    }
    let mut mant: string = rest;
    let mut exp: int = 0;
    let ei: int = index_of(rest, "e");
    let EI: int = index_of(rest, "E");
    let mut epos: int = ei;
    if epos < 0 {
        epos = EI;
    }
    if epos >= 0 {
        mant = substring(rest, 0, epos);
        let expart: string = substring(rest, epos + 1, len(rest));
        let mut esign: int = 1;
        let mut edigits: string = expart;
        if len(expart) > 0 && char_at(expart, 0) == "-" {
            esign = -1;
            edigits = substring(expart, 1, len(expart));
        } else if len(expart) > 0 && char_at(expart, 0) == "+" {
            edigits = substring(expart, 1, len(expart));
        }
        if !db_is_digits(edigits) {
            return Err("bad float payload in db framing");
        }
        exp = esign * parse_int(edigits);
    }
    let mut ip: string = mant;
    let mut fp: string = "";
    let dot: int = index_of(mant, ".");
    if dot >= 0 {
        ip = substring(mant, 0, dot);
        fp = substring(mant, dot + 1, len(mant));
    }
    if ip == "" {
        ip = "0";
    }
    if fp == "" {
        fp = "0";
    }
    if !db_is_digits(ip) || !db_is_digits(fp) {
        return Err("bad float payload in db framing");
    }
    let mut v: float = to_float(parse_int(ip));
    let mut scale: float = 1.0;
    for c in split(fp, "") {
        scale = scale * 10.0;
        v = v + to_float(parse_int(c)) / scale;
    }
    let mut k: int = 0;
    while k < exp {
        v = v * 10.0;
        k = k + 1;
    }
    while k > exp {
        v = v / 10.0;
        k = k - 1;
    }
    if neg {
        v = 0.0 - v;
    }
    return Ok(v);
}

fn db_decode_rows(s: string) -> Result<Array<Array<DbVal>>, string> {
    let mut pos: int = 0;
    if pos >= len(s) || char_at(s, pos) != "R" {
        return Err("bad db framing (want 'R')");
    }
    pos = pos + 1;
    let mut ns: string = "";
    while pos < len(s) && db_is_digits(char_at(s, pos)) {
        ns = ns + char_at(s, pos);
        pos = pos + 1;
    }
    if ns == "" {
        return Err("bad db framing (want row count)");
    }
    let nrows: int = parse_int(ns);
    if pos >= len(s) || char_at(s, pos) != ":" {
        return Err("bad db framing (want ':')");
    }
    pos = pos + 1;
    let mut rows: Array<Array<DbVal>> = [];
    let mut r: int = 0;
    while r < nrows {
        if pos >= len(s) || char_at(s, pos) != "C" {
            return Err("bad db framing (want 'C')");
        }
        pos = pos + 1;
        let mut ms: string = "";
        while pos < len(s) && db_is_digits(char_at(s, pos)) {
            ms = ms + char_at(s, pos);
            pos = pos + 1;
        }
        if ms == "" {
            return Err("bad db framing (want cell count)");
        }
        let ncols: int = parse_int(ms);
        if pos >= len(s) || char_at(s, pos) != ":" {
            return Err("bad db framing (want ':')");
        }
        pos = pos + 1;
        let mut row: Array<DbVal> = [];
        let mut ci: int = 0;
        while ci < ncols {
            let mut ks: string = "";
            while pos < len(s) && db_is_digits(char_at(s, pos)) {
                ks = ks + char_at(s, pos);
                pos = pos + 1;
            }
            if ks == "" {
                return Err("bad db framing (want kind)");
            }
            let kind: int = parse_int(ks);
            if pos >= len(s) || char_at(s, pos) != "," {
                return Err("bad db framing (want ',')");
            }
            pos = pos + 1;
            let mut ls: string = "";
            while pos < len(s) && db_is_digits(char_at(s, pos)) {
                ls = ls + char_at(s, pos);
                pos = pos + 1;
            }
            if ls == "" {
                return Err("bad db framing (want length)");
            }
            let payload_len: int = parse_int(ls);
            if pos >= len(s) || char_at(s, pos) != ":" {
                return Err("bad db framing (want ':')");
            }
            pos = pos + 1;
            if pos + payload_len > len(s) {
                return Err("bad db framing (short payload)");
            }
            let payload: string = substring(s, pos, pos + payload_len);
            pos = pos + payload_len;
            if pos >= len(s) || char_at(s, pos) != ";" {
                return Err("bad db framing (want ';')");
            }
            pos = pos + 1;
            if kind == 0 {
                push(row, db_null());
            } else if kind == 1 {
                if !db_is_int_payload(payload) {
                    return Err("bad db framing (bad int payload)");
                }
                push(row, db_int(parse_int(payload)));
            } else if kind == 2 {
                push(row, db_float(db_parse_float(payload)?));
            } else if kind == 3 {
                push(row, db_text(payload));
            } else if kind == 4 {
                if payload == "1" {
                    push(row, db_bool(true));
                } else if payload == "0" {
                    push(row, db_bool(false));
                } else {
                    return Err("bad db framing (bad bool payload)");
                }
            } else {
                return Err("bad db framing (bad kind)");
            }
            ci = ci + 1;
        }
        push(rows, row);
        r = r + 1;
    }
    if pos != len(s) {
        return Err("bad db framing (trailing bytes)");
    }
    return Ok(rows);
}

fn db_is_int_payload(s: string) -> bool {
    let mut t: string = s;
    if len(t) > 0 && char_at(t, 0) == "-" {
        t = substring(t, 1, len(t));
    }
    return db_is_digits(t);
}

fn db_exec(dsn: string, sql: string, args: Array<DbVal>) -> Result<int, string> {
    let n = toto_rt_db_exec(dsn, sql, db_encode_params(args));
    if n < 0 {
        return Err(db_last_error());
    }
    return Ok(n);
}

fn db_query(dsn: string, sql: string, args: Array<DbVal>) -> Result<Array<Array<DbVal>>, string> {
    let framed = toto_rt_db_query(dsn, sql, db_encode_params(args));
    if framed == "" {
        return Err(db_last_error());
    }
    return db_decode_rows(framed);
}

fn db_pool_config(dsn: string, max: int, timeout_ms: int) -> Result<int, string> {
    let rc = toto_rt_db_pool_config(dsn, max, timeout_ms);
    if rc < 0 {
        return Err(db_last_error());
    }
    return Ok(rc);
}

fn db_close_pool(dsn: string) -> Result<int, string> {
    let rc = toto_rt_db_close_pool(dsn);
    if rc < 0 {
        return Err(db_last_error());
    }
    return Ok(rc);
}
