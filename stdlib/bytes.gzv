//! `gzv.std/bytes` — canonical binary-data vocabulary (Wave 6,
//! Group C item 23).
//!
//! Bytes ride as `Array<int>` (values 0-255), the carrier the
//! jwt/crypto/saml codecs already use. This module is the one
//! home for the base64/base64url/hex tables (previously copied
//! per module), slicing and concatenation, and u16/u32
//! little/big-endian pack/unpack via arithmetic (the language
//! has no shifts; `*256` and `/256` cover them exactly).
//! Decode failures are loud `Err`s, never silent defaults;
//! out-of-range getters panic like `data[i]` itself, and
//! encoders reject out-of-range values with `Err`.

import "gzv.std/strings.gzv";

/// Standard base64 alphabet (`+/`, RFC 4648 §4).
fn b64_alpha() -> string {
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
}

/// URL-safe base64 alphabet (`-_`, JWT style).
fn b64url_alpha() -> string {
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
}

/// 6-bit value of a base64 char in the given alphabet, or -1.
fn b64_val(alpha: string, c: string) -> int {
    let n: int = len(alpha);
    let mut i: int = 0;
    while i < n {
        if char_at(alpha, i) == c {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// One lowercase hex digit.
fn hexdig(v: int) -> string {
    let digits: string = "0123456789abcdef";
    return char_at(digits, v);
}

/// Numeric value of one hex char (either case), or -1.
fn hexval(c: string) -> int {
    let digits: string = "0123456789abcdefABCDEF";
    let mut i: int = 0;
    while i < len(digits) {
        if char_at(digits, i) == c {
            if i < 16 {
                return i;
            }
            return i - 6;
        }
        i = i + 1;
    }
    return -1;
}

/// Bytes to padded standard base64 (RFC 4648 `+/` alphabet).
pub fn bytes_b64_encode(data: Array<int>) -> string {
    let alpha: string = b64_alpha();
    let mut out: string = "";
    let mut i: int = 0;
    while i + 3 <= len(data) {
        let b0: int = data[i];
        let b1: int = data[i + 1];
        let b2: int = data[i + 2];
        let s0: int = b0 / 4;
        let r0: int = b0 - s0 * 4;
        let s1: int = r0 * 16 + b1 / 16;
        let r1: int = b1 - (b1 / 16) * 16;
        let s2: int = r1 * 4 + b2 / 64;
        let s3: int = b2 - (b2 / 64) * 64;
        out = out + char_at(alpha, s0) + char_at(alpha, s1) + char_at(alpha, s2) + char_at(alpha, s3);
        i = i + 3;
    }
    let rem: int = len(data) - i;
    if rem == 1 {
        let b0: int = data[i];
        let s0: int = b0 / 4;
        let r0: int = b0 - s0 * 4;
        out = out + char_at(alpha, s0) + char_at(alpha, r0 * 16) + "==";
    }
    if rem == 2 {
        let b0: int = data[i];
        let b1: int = data[i + 1];
        let s0: int = b0 / 4;
        let r0: int = b0 - s0 * 4;
        let s1: int = r0 * 16 + b1 / 16;
        let r1: int = b1 - (b1 / 16) * 16;
        out = out + char_at(alpha, s0) + char_at(alpha, s1) + char_at(alpha, r1 * 4) + "=";
    }
    return out;
}

/// Padded standard base64 to bytes. Transport-folded whitespace
/// (space/LF/CR/TAB) is skipped, not rejected; anything else
/// outside the alphabet is a loud Err. `=` terminates the
/// payload (padding must be 1-2 chars at the very end —
/// anything after it is an Err).
pub fn bytes_b64_decode(s: string) -> Result<Array<int>, string> {
    let alpha: string = b64_alpha();
    let mut vals: Array<int> = [];
    let mut pads: int = 0;
    for c in split(s, "") {
        if pads > 0 {
            if c == "=" && pads < 2 {
                pads = pads + 1;
            } else if c == " " || c == "\n" || c == "\r" || c == "\t" {
            } else {
                return Err("bad base64 (trailing data after padding)");
            }
        } else if c == " " || c == "\n" || c == "\r" || c == "\t" {
        } else if c == "=" {
            pads = 1;
        } else {
            let v: int = b64_val(alpha, c);
            if v < 0 {
                return Err("bad base64 (bad char)");
            }
            push(vals, v);
        }
    }
    if len(vals) % 4 == 1 {
        return Err("bad base64 (bad length)");
    }
    let mut out: Array<int> = [];
    let mut i: int = 0;
    while i + 4 <= len(vals) {
        let s0: int = vals[i];
        let s1: int = vals[i + 1];
        let s2: int = vals[i + 2];
        let s3: int = vals[i + 3];
        push(out, s0 * 4 + s1 / 16);
        push(out, (s1 - (s1 / 16) * 16) * 16 + s2 / 4);
        push(out, (s2 - (s2 / 4) * 4) * 64 + s3);
        i = i + 4;
    }
    let rem: int = len(vals) - i;
    if rem == 2 {
        push(out, vals[i] * 4 + vals[i + 1] / 16);
    }
    if rem == 3 {
        let s0: int = vals[i];
        let s1: int = vals[i + 1];
        let s2: int = vals[i + 2];
        push(out, s0 * 4 + s1 / 16);
        push(out, (s1 - (s1 / 16) * 16) * 16 + s2 / 4);
    }
    return Ok(out);
}

/// Bytes to unpadded base64url (JWT style — never emits `=`).
pub fn bytes_b64url_encode(data: Array<int>) -> string {
    let alpha: string = b64url_alpha();
    let mut out: string = "";
    let mut i: int = 0;
    while i + 3 <= len(data) {
        let b0: int = data[i];
        let b1: int = data[i + 1];
        let b2: int = data[i + 2];
        let s0: int = b0 / 4;
        let r0: int = b0 - s0 * 4;
        let s1: int = r0 * 16 + b1 / 16;
        let r1: int = b1 - (b1 / 16) * 16;
        let s2: int = r1 * 4 + b2 / 64;
        let s3: int = b2 - (b2 / 64) * 64;
        out = out + char_at(alpha, s0) + char_at(alpha, s1) + char_at(alpha, s2) + char_at(alpha, s3);
        i = i + 3;
    }
    let rem: int = len(data) - i;
    if rem == 1 {
        let b0: int = data[i];
        let s0: int = b0 / 4;
        let r0: int = b0 - s0 * 4;
        out = out + char_at(alpha, s0) + char_at(alpha, r0 * 16);
    }
    if rem == 2 {
        let b0: int = data[i];
        let b1: int = data[i + 1];
        let s0: int = b0 / 4;
        let r0: int = b0 - s0 * 4;
        let s1: int = r0 * 16 + b1 / 16;
        let r1: int = b1 - (b1 / 16) * 16;
        out = out + char_at(alpha, s0) + char_at(alpha, s1) + char_at(alpha, r1 * 4);
    }
    return out;
}

/// Unpadded base64url to bytes. Padding `=` is rejected (JWT
/// style — loud Err, never silently accepted).
pub fn bytes_b64url_decode(s: string) -> Result<Array<int>, string> {
    let alpha: string = b64url_alpha();
    let mut vals: Array<int> = [];
    for c in split(s, "") {
        if c == "=" {
            return Err("bad base64url (padding rejected)");
        }
        let v: int = b64_val(alpha, c);
        if v < 0 {
            return Err("bad base64url (bad char)");
        }
        push(vals, v);
    }
    let mut out: Array<int> = [];
    let mut i: int = 0;
    while i + 4 <= len(vals) {
        let s0: int = vals[i];
        let s1: int = vals[i + 1];
        let s2: int = vals[i + 2];
        let s3: int = vals[i + 3];
        push(out, s0 * 4 + s1 / 16);
        push(out, (s1 - (s1 / 16) * 16) * 16 + s2 / 4);
        push(out, (s2 - (s2 / 4) * 4) * 64 + s3);
        i = i + 4;
    }
    let rem: int = len(vals) - i;
    if rem == 1 {
        return Err("bad base64url (bad length)");
    }
    if rem == 2 {
        let s0: int = vals[i];
        let s1: int = vals[i + 1];
        push(out, s0 * 4 + s1 / 16);
    }
    if rem == 3 {
        let s0: int = vals[i];
        let s1: int = vals[i + 1];
        let s2: int = vals[i + 2];
        push(out, s0 * 4 + s1 / 16);
        push(out, (s1 - (s1 / 16) * 16) * 16 + s2 / 4);
    }
    return Ok(out);
}

/// Bytes to lowercase hex.
pub fn bytes_hex_encode(data: Array<int>) -> string {
    let mut out: string = "";
    for b in data {
        let hi: int = b / 16;
        let lo: int = b - hi * 16;
        out = out + hexdig(hi) + hexdig(lo);
    }
    return out;
}

/// Hex to bytes; Err on odd length or non-hex (never silent).
/// Either case decodes.
pub fn bytes_hex_decode(s: string) -> Result<Array<int>, string> {
    let chars: Array<string> = split(s, "");
    if len(chars) % 2 != 0 {
        return Err("bad hex (odd length)");
    }
    let mut out: Array<int> = [];
    let mut i: int = 0;
    while i < len(chars) {
        let hi: int = hexval(chars[i]);
        let lo: int = hexval(chars[i + 1]);
        if hi < 0 || lo < 0 {
            return Err("bad hex (non-hex digit)");
        }
        push(out, hi * 16 + lo);
        i = i + 2;
    }
    return Ok(out);
}

/// Slice `[start, end)` as a fresh array. Out-of-range indexes
/// panic, exactly like `data[i]` itself.
pub fn bytes_slice(data: Array<int>, start: int, end: int) -> Array<int> {
    let mut out: Array<int> = [];
    let mut i: int = start;
    while i < end {
        push(out, data[i]);
        i = i + 1;
    }
    return out;
}

/// Concatenate two byte arrays into a fresh array.
pub fn bytes_concat(a: Array<int>, b: Array<int>) -> Array<int> {
    let mut out: Array<int> = [];
    for x in a {
        push(out, x);
    }
    for x in b {
        push(out, x);
    }
    return out;
}

/// True when every element is a byte (0-255).
pub fn bytes_is_valid(data: Array<int>) -> bool {
    for b in data {
        if b < 0 || b > 255 {
            return false;
        } else {
        }
    }
    return true;
}

/// Little-endian u16 at `at` (panics out of range).
pub fn bytes_u16le(data: Array<int>, at: int) -> int {
    return data[at] + data[at + 1] * 256;
}

/// Big-endian u16 at `at` (panics out of range).
pub fn bytes_u16be(data: Array<int>, at: int) -> int {
    return data[at] * 256 + data[at + 1];
}

/// Little-endian u32 at `at` (panics out of range).
pub fn bytes_u32le(data: Array<int>, at: int) -> int {
    return data[at] + data[at + 1] * 256 + data[at + 2] * 65536 + data[at + 3] * 16777216;
}

/// Big-endian u32 at `at` (panics out of range).
pub fn bytes_u32be(data: Array<int>, at: int) -> int {
    return data[at] * 16777216 + data[at + 1] * 65536 + data[at + 2] * 256 + data[at + 3];
}

/// Little-endian u16 as two bytes; Err outside 0-65535.
pub fn bytes_u16le_bytes(v: int) -> Result<Array<int>, string> {
    if v < 0 || v > 65535 {
        return Err("u16 out of range");
    }
    let hi: int = v / 256;
    let lo: int = v - hi * 256;
    return Ok([lo, hi]);
}

/// Big-endian u16 as two bytes; Err outside 0-65535.
pub fn bytes_u16be_bytes(v: int) -> Result<Array<int>, string> {
    if v < 0 || v > 65535 {
        return Err("u16 out of range");
    }
    let hi: int = v / 256;
    let lo: int = v - hi * 256;
    return Ok([hi, lo]);
}

/// Little-endian u32 as four bytes; Err outside 0-4294967295.
pub fn bytes_u32le_bytes(v: int) -> Result<Array<int>, string> {
    if v < 0 || v > 4294967295 {
        return Err("u32 out of range");
    }
    let b3: int = v / 16777216;
    let r3: int = v - b3 * 16777216;
    let b2: int = r3 / 65536;
    let r2: int = r3 - b2 * 65536;
    let b1: int = r2 / 256;
    let b0: int = r2 - b1 * 256;
    return Ok([b0, b1, b2, b3]);
}

/// Big-endian u32 as four bytes; Err outside 0-4294967295.
pub fn bytes_u32be_bytes(v: int) -> Result<Array<int>, string> {
    if v < 0 || v > 4294967295 {
        return Err("u32 out of range");
    }
    let b3: int = v / 16777216;
    let r3: int = v - b3 * 16777216;
    let b2: int = r3 / 65536;
    let r2: int = r3 - b2 * 65536;
    let b1: int = r2 / 256;
    let b0: int = r2 - b1 * 256;
    return Ok([b3, b2, b1, b0]);
}
