// `gzv.std/secrets` — secrets: fetch + rotate (Wave 3, Stage 4).
//
// One seam, three providers — `env`, `file`, `vault` — plus
// the explicit gap (`aws`/`gcp`/`azure` parse as names but
// report "not configured"; the seam is the deliverable, not
// the cloud drivers). Every provider serves the same two
// operations: `secrets_fetch` reads one secret string,
// `secrets_rotate` writes a new value and returns a version
// stamp (`vault` returns the KV-v2 version number, `file`
// returns `"file"`). Loud `Err`s name provider + key +
// reason; nothing returns a default secret, ever.
//
// Provider semantics:
// - `env`: the secret is an environment variable; fetch Errs
//   when unset OR empty (an empty password is a misconfig,
//   never a credential); rotate is refused (process env is
//   not a store — use the deployment's secret injection).
// - `file`: the secret is a file's contents (Docker secrets,
//   tmpfs mounts); fetch Errs when the path is missing;
//   rotate writes the file (documented: whoever mounts it
//   owns the permissions).
// - `vault`: HashiCorp Vault KV-v2 over the Wave 2 HTTP
//   client (loopback-only by construction — a Vault dev
//   server on 127.0.0.1 is exactly the CI proof). Address
//   and token come from `VAULT_ADDR` / `VAULT_TOKEN`, never
//   from arguments or fixtures. Name is `mount/path[#field]`
//   (default field `value`); rotate is a KV-v2 PUT and
//   returns the new version number as a string.
// - cloud names: `secrets_is_available` is false and both
//   operations Err with the gap named. No silent fallback.
import "gzv.std/config.gzv";
import "gzv.std/http.gzv";
import "gzv.std/json.gzv";
import "gzv.std/strings.gzv";

pub struct SecretRef {
    provider: string,
    name: string
}

pub fn secret_ref(provider: string, name: string) -> SecretRef {
    return SecretRef { provider: provider, name: name };
}

// Availability: `env`/`file` are always wired (per-key errors
// still surface at fetch); `vault` needs both env vars;
// cloud names are never available in v1.
pub fn secrets_is_available(provider: string) -> bool {
    if provider == "env" {
        return true;
    } else if provider == "file" {
        return true;
    } else if provider == "vault" {
        if config_env_has("VAULT_ADDR") && config_env_has("VAULT_TOKEN") {
            return true;
        } else {
        }
        return false;
    } else {
    }
    return false;
}

pub fn secrets_providers() -> Array<string> {
    return ["env", "file", "vault", "aws", "gcp", "azure"];
}

pub fn secrets_fetch(provider: string, name: string) -> Result<string, string> {
    if provider == "env" {
        if !config_env_has(name) {
            return Err("env secret not set: " + name);
        } else {
        }
        let v: string = config_env_get(name);
        if v == "" {
            return Err("env secret empty (misconfigured): " + name);
        } else {
        }
        return Ok(v);
    } else if provider == "file" {
        if !file_exists(name) {
            return Err("secret file missing: " + name);
        } else {
        }
        return Ok(read_file(name));
    } else if provider == "vault" {
        return secrets_vault_fetch(name);
    } else {
    }
    return Err("unknown secrets provider: " + provider);
}

pub fn secrets_fetch_ref(r: SecretRef) -> Result<string, string> {
    return secrets_fetch(r.provider, r.name);
}

// First configured source wins (fallback chains: Vault ->
// env for local dev). Fail-CLOSED: a source is skipped only
// when provably absent (unset env, missing file, vault
// unconfigured); a present source that fails to read
// propagates its Err loudly instead of falling through to
// the next source. Err names every tried ref when none is
// configured.
pub fn secrets_fetch_first(refs: Array<SecretRef>) -> Result<string, string> {
    let mut tried: string = "";
    for r in refs {
        if secrets_present(r.provider, r.name) {
            return secrets_fetch(r.provider, r.name);
        } else {
        }
        if tried != "" {
            tried = tried + ", ";
        }
        tried = tried + r.provider + ":" + r.name;
    }
    return Err("no secret configured (tried " + tried + ")");
}

// Presence probe (pure bool): is this source even configured?
// Never touches the network; vault presence is env + name
// shape only — auth/transport failures still surface loudly
// from `secrets_fetch`.
fn secrets_present(provider: string, name: string) -> bool {
    if provider == "env" {
        if !config_env_has(name) {
            return false;
        } else {
        }
        return config_env_get(name) != "";
    } else if provider == "file" {
        return file_exists(name);
    } else if provider == "vault" {
        return secrets_is_available("vault") && secrets_vault_shape_ok(name);
    } else {
    }
    return false;
}

pub fn secrets_rotate(provider: string, name: string, value: string) -> Result<string, string> {
    if provider == "file" {
        if name == "" {
            return Err("file provider needs a path");
        } else {
        }
        write_file(name, value);
        return Ok("file");
    } else if provider == "vault" {
        return secrets_vault_write(name, value);
    } else if provider == "env" {
        return Err("env secrets cannot be rotated (not a store)");
    } else {
    }
    return Err("unknown secrets provider: " + provider);
}

// --- Vault KV-v2 (private) ---

fn secrets_vault_base() -> Result<string, string> {
    if !config_env_has("VAULT_ADDR") {
        return Err("vault: VAULT_ADDR not set");
    } else {
    }
    if !config_env_has("VAULT_TOKEN") {
        return Err("vault: VAULT_TOKEN not set");
    } else {
    }
    return Ok(config_env_get("VAULT_ADDR"));
}

fn secrets_vault_headers() -> Array<HttpHeader> {
    let tok: string = config_env_get("VAULT_TOKEN");
    return [HttpHeader { name: "X-Vault-Token", value: tok }];
}

fn secrets_vault_opts() -> HttpClientOpts {
    return HttpClientOpts { max_body: 1048576, redirects: 0, host_allow: [] };
}

fn secrets_vault_split(name: string) -> Result<SecretsVaultPath, string> {
    let hash: int = index_of(name, "#");
    let mut path: string = name;
    let mut field: string = "value";
    if hash >= 0 {
        path = substring(name, 0, hash);
        field = substring(name, hash + 1, len(name));
    }
    let slash: int = index_of(path, "/");
    if slash < 0 {
        return Err("vault name needs mount/path[#field], got: " + name);
    }
    let mount: string = substring(path, 0, slash);
    let rest: string = substring(path, slash + 1, len(path));
    if mount == "" || rest == "" {
        return Err("vault name needs mount/path[#field], got: " + name);
    }
    return Ok(SecretsVaultPath { mount: mount, path: rest, field: field });
}

struct SecretsVaultPath {
    mount: string,
    path: string,
    field: string
}

fn secrets_vault_fetch(name: string) -> Result<string, string> {
    let addr: string = secrets_vault_base()?;
    let p: SecretsVaultPath = secrets_vault_split(name)?;
    let url: string = addr + "/v1/" + p.mount + "/data/" + p.path;
    let req = HttpClientReq { method: "GET", url: url, headers: secrets_vault_headers(), body: [], ca_pem: "" };
    let got: HttpClientResp = http_do(req, secrets_vault_opts())?;
    if got.status != 200 {
        return Err("vault read status " + to_string(got.status) + " for: " + name);
    }
    let text: string = http_bytes_to_text(got.body)?;
    let d: JsonVal = json_parse(text)?;
    let data: JsonVal = json_object_get(d, "data")?;
    let inner: JsonVal = json_object_get(data, "data")?;
    let fv: JsonVal = json_object_get(inner, p.field)?;
    return Ok(json_as_string(fv)?);
}

// Name-shape probe for the cascade (no I/O): mount/path with
// non-empty segments, optional #field.
fn secrets_vault_shape_ok(name: string) -> bool {
    let mut path: string = name;
    let hash: int = index_of(name, "#");
    if hash >= 0 {
        path = substring(name, 0, hash);
        let field: string = substring(name, hash + 1, len(name));
        if field == "" {
            return false;
        } else {
        }
    } else {
    }
    let slash: int = index_of(path, "/");
    if slash < 0 {
        return false;
    } else {
    }
    if substring(path, 0, slash) == "" {
        return false;
    } else {
    }
    return substring(path, slash + 1, len(path)) != "";
}

fn secrets_vault_write(name: string, value: string) -> Result<string, string> {
    let base: string = secrets_vault_base()?;
    let p: SecretsVaultPath = secrets_vault_split(name)?;
    let url: string = base + "/v1/" + p.mount + "/data/" + p.path;
    let payload: string = "{\"data\":{\"" + p.field + "\":\"" + secrets_json_escape(value) + "\"}}";
    let resp: HttpClientResp = http_post(url, secrets_vault_headers(), http_text_to_bytes(payload)?, secrets_vault_opts())?;
    if resp.status != 200 {
        return Err("vault write status " + to_string(resp.status) + " for: " + name);
    }
    let text: string = http_bytes_to_text(resp.body)?;
    let d: JsonVal = json_parse(text)?;
    let data: JsonVal = json_object_get(d, "data")?;
    let ver: JsonVal = json_object_get(data, "version")?;
    // KV-v2 versions are JSON numbers — render, don't cast.
    return Ok(to_string(json_as_int(ver)?));
}

fn secrets_json_escape(s: string) -> string {
    let cs: Array<string> = split(s, "");
    let mut out: string = "";
    for c in cs {
        if c == "\"" {
            out = out + "\\\"";
        } else {
            if c == "\\" {
                out = out + "\\\\";
            } else {
                if c == "\n" {
                    out = out + "\\n";
                } else {
                    out = out + c;
                }
            }
        }
    }
    return out;
}

// JSON string escaping for the KV-v2 PUT payload (the only
// JSON this module constructs by hand).
