//! `gzv.std/password` — password hashing and verification
//! (Enterprise Wave 3, Stage 3).
//!
//! PBKDF2-HMAC-SHA256 with a 16-byte random salt and 600k
//! iterations by default (OWASP 2023); the KDF itself runs in
//! the linked libcrypto (`crypto_pbkdf2`, never Toto code —
//! 600k HMAC rounds in Toto would take minutes). Verification
//! re-derives and compares in constant-time native code.
//! Stored form: `$toto$pbkdf2-sha256$i=<n>$l=<hex salt>$<hex
//! hash>` — hex (not base64) so the codec stays dependency-free
//! and auditable in a dozen lines; hashes are fixed invalid-UTF8
//! risks (hex is ASCII).
import "gzv.std/crypto.gzv";
import "gzv.std/strings.gzv";
import "gzv.std/bytes.gzv";

pub fn pw_default_iterations() -> int {
    return 600000;
}

fn pw_is_digits(s: string) -> bool {
    if len(s) == 0 {
        return false;
    }
    for c in split(s, "") {
        if c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c == "5" || c == "6" || c == "7" || c == "8" || c == "9" {
        } else {
            return false;
        }
    }
    return true;
}

/// Bytes to lowercase hex (ASCII only — safe for framing and
/// goldens regardless of input bytes).
pub fn pw_hex_encode(data: Array<int>) -> string {
    return bytes_hex_encode(data);
}

/// Hex to bytes; Err on odd length or non-hex (never silent).
/// Either case decodes (canonical `bytes` rule; `pw` never
/// emits uppercase, so all in-tree vectors are unchanged).
pub fn pw_hex_decode(s: string) -> Result<Array<int>, string> {
    return bytes_hex_decode(s);
}

fn pw_format(iterations: int, salt_hex: string, hash_hex: string) -> string {
    return "$toto$pbkdf2-sha256$i=" + to_string(iterations) + "$l=" + salt_hex + "$" + hash_hex;
}

/// Hash a password with an explicit iteration count (tests pin
/// small counts for speed with exact vectors; production uses
/// `pw_hash`).
pub fn pw_hash_with_iterations(password: string, iterations: int) -> Result<string, string> {
    if iterations < 1 {
        return Err("pbkdf2: need positive iterations, got " + to_string(iterations));
    }
    let salt = crypto_random(16)?;
    let key = crypto_pbkdf2(password, salt, iterations)?;
    return Ok(pw_format(iterations, pw_hex_encode(salt), pw_hex_encode(key)));
}

/// Hash a password with the default OWASP count (~0.3 s —
/// documented cost; async offload is a recorded follow-up).
pub fn pw_hash(password: string) -> Result<string, string> {
    return pw_hash_with_iterations(password, pw_default_iterations());
}

/// Verify a password against a stored hash. Malformed stored
/// forms are an Err (never a silent false); a wrong password is
/// Ok(false).
pub fn pw_verify(password: string, stored: string) -> Result<bool, string> {
    let parts: Array<string> = split(stored, "$");
    // ["", "toto", "pbkdf2-sha256", "i=N", "l=SALT", "HASH"]
    if len(parts) != 6 || parts[0] != "" || parts[1] != "toto" || parts[2] != "pbkdf2-sha256" {
        return Err("bad password hash format");
    }
    if !starts_with(parts[3], "i=") || !starts_with(parts[4], "l=") {
        return Err("bad password hash format");
    }
    let iters_s: string = substring(parts[3], 2, len(parts[3]));
    if !pw_is_digits(iters_s) {
        return Err("bad password hash format");
    }
    let iters = parse_int(iters_s);
    let salt = pw_hex_decode(substring(parts[4], 2, len(parts[4])))?;
    let want = pw_hex_decode(parts[5])?;
    if len(salt) != 16 || len(want) != 32 {
        return Err("bad password hash format");
    }
    let got = crypto_pbkdf2(password, salt, iters)?;
    let v = crypto_pbkdf2_verify(want, got)?;
    if v == 1 {
        return Ok(true);
    } else {
    }
    return Ok(false);
}
