//! gzv.std/strings — string helpers on the frozen builtins.
//!
//! `split(s, "")` is the sanctioned character-access path: the builtin
//! splits into one-element strings (Unicode scalar values), so indexing
//! the result walks the string character by character. `len(s)` counts
//! the same scalar values, so `char_at`/`substring` indices agree with
//! `len`. Concatenation is `+`.

pub fn is_empty(s: string) -> bool {
    return len(s) == 0;
}

pub fn starts_with(s: string, prefix: string) -> bool {
    if len(prefix) == 0 {
        return true;
    }
    let parts: Array<string> = split(s, prefix);
    return len(parts) > 1 && parts[0] == "";
}

pub fn ends_with(s: string, suffix: string) -> bool {
    if len(suffix) == 0 {
        return true;
    }
    let parts: Array<string> = split(s, suffix);
    return len(parts) > 1 && parts[len(parts) - 1] == "";
}

pub fn join(parts: Array<string>, sep: string) -> string {
    let mut out: string = "";
    let mut first: bool = true;
    for p in parts {
        if first {
            first = false;
        } else {
            out = out + sep;
        }
        out = out + p;
    }
    return out;
}

pub fn repeat(s: string, n: int) -> string {
    let mut out: string = "";
    for i in 0..n {
        out = out + s;
    }
    return out;
}

pub fn replace(s: string, from: string, to: string) -> string {
    if len(from) == 0 {
        return s;
    }
    return join(split(s, from), to);
}

pub fn char_at(s: string, i: int) -> string {
    return split(s, "")[i];
}

pub fn substring(s: string, start: int, end: int) -> string {
    let chars: Array<string> = split(s, "");
    let mut out: string = "";
    for i in start..end {
        out = out + chars[i];
    }
    return out;
}

/// Byte-free first occurrence of `needle` in `s`, or -1 when absent.
/// Scans with `starts_with` so the result is a character index.
pub fn index_of(s: string, needle: string) -> int {
    if len(needle) == 0 {
        return 0;
    }
    let n: int = len(s);
    for i in 0..n {
        if starts_with(substring(s, i, n), needle) {
            return i;
        } else {
        }
    }
    return -1;
}

pub fn pad_left(s: string, width: int, pad: string) -> string {
    let mut out: string = s;
    while len(out) < width {
        out = pad + out;
    }
    return out;
}

pub fn pad_right(s: string, width: int, pad: string) -> string {
    let mut out: string = s;
    while len(out) < width {
        out = out + pad;
    }
    return out;
}
