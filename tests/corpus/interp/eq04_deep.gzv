struct Pair { x: int, y: int }

fn main() -> int {
    println([[1, 2], [3]] == [[1, 2], [3]]);
    println([1] == [1, 2]);
    println(Pair { x: 1, y: 2 } == Pair { x: 1, y: 2 });
    println(Pair { x: 1, y: 2 } == Pair { x: 1, y: 3 });
    println([[1]] == [[2]]);
    println(Pair { x: 0, y: 0 } == Pair { x: 0, y: 0 });
    return 0;
}
