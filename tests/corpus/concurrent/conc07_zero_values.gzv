struct Pair { a: int, b: string }
fn main() -> int {
    let s = chan<string>();
    close(s);
    println(<-s);
    let o = chan<Option<int>>();
    close(o);
    println(<-o);
    let r = chan<Result<int, string>>(1);
    r <- Err("boom");
    close(r);
    println(<-r);
    println(<-r);
    let p = chan<Pair>();
    close(p);
    let q = <-p;
    println(q.a);
    println(q.b);
    return 0;
}
