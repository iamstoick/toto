// Wave 3 Stage 5 reference service (golden): the DB-backed,
// authed HTTPS service over loopback, driven by an in-process
// client as the integration proof. Deterministic by
// construction (proj20 precedent): no ports, fds, or timing
// in the output; per-request latency observations are the
// fixed 1ms stand-in; `ts` is normalized; random passwords,
// salts, and the JWT key never print.
//
// Exercises: config file + typed getters (port/dsn/ttl),
// migrations at startup, seeded PBKDF2 users, login → JWT,
// Bearer-gated reads/writes, every 401 shape, forged-token
// abort (fail-closed v1 deviation), expired-token 401,
// unknown-user 404, byte-exact metrics scrape, wrong-CA
// rejection + survival, buffered-log drain.
import "common.gzv";
import "gzv.std/config.gzv";
import "gzv.std/context.gzv";
import "gzv.std/crypto.gzv";
import "gzv.std/db.gzv";
import "gzv.std/http.gzv";
import "gzv.std/json.gzv";
import "gzv.std/jwt.gzv";
import "gzv.std/log.gzv";
import "gzv.std/metrics.gzv";
import "gzv.std/strings.gzv";
import "gzv.std/time.gzv";
import "gzv.std/trace.gzv";

// Env overlay for the interop leg (mirrors load.gzv): the corpus
// golden runs on file defaults; the Rust interop test points at
// fresh fixtures + the real collector.
fn env_or(name: string, dflt: string) -> string {
    if config_env_has(name) {
        return config_env_get(name);
    } else {
    }
    return dflt;
}

fn env_int(name: string, dflt: int) -> Result<int, string> {
    let raw = env_or(name, "");
    if raw == "" {
        return Ok(dflt);
    } else {
    }
    return config_parse_int(raw);
}

// Normalize the nondeterministic `ts` to 0 using the exact wire
// format (`{"ts":NNN,"level":...}`) — same shape as proj17.
fn strip_ts(line: string) -> Result<string, string> {
    let parts = split(line, "{\"ts\":");
    if len(parts) != 2 {
        return Err("no ts prefix");
    } else {
    }
    let tail = split(parts[1], ",\"level\":\"");
    if len(tail) < 2 {
        return Err("no level separator");
    } else {
    }
    let mut rest = tail[1];
    let mut i = 2;
    while i < len(tail) {
        rest = rest + ",\"level\":\"" + tail[i];
        i = i + 1;
    }
    return Ok("{\"ts\":0,\"level\":\"" + rest);
}

// NOTE: `http_post` hardcodes `ca_pem: ""` (plain-HTTP only) and
// hangs against an `https://` URL instead of failing — repro'd
// this turn, carried as a Wave-2 follow-up. TLS posts go through
// `http_do` with the pinned CA (proj20 precedent).
fn post_login(base: string, ca: string, user: string, pw: string, copts: HttpClientOpts) -> Result<HttpClientResp, string> {
    let body = http_text_to_bytes("{\"user\":\"" + user + "\",\"password\":\"" + pw + "\"}")?;
    return http_do(HttpClientReq { method: "POST", url: base + "/login", headers: [], body: body, ca_pem: ca }, copts);
}

fn get_authed(base: string, ca: string, target: string, tok: string, copts: HttpClientOpts) -> Result<HttpClientResp, string> {
    let hs: Array<HttpHeader> = [HttpHeader { name: "Authorization", value: "Bearer " + tok }];
    return http_do(HttpClientReq { method: "GET", url: base + target, headers: hs, body: [], ca_pem: ca }, copts);
}

// Any-Err-is-good probe (proj16 shape): the exchange must FAIL;
// an unexpected success becomes the fixed marker the caller CAN
// compare against.
fn neg_probe(make_bad: fn() -> Result<HttpClientResp, string>) -> Result<string, string> {
    make_bad()?;
    return Err("http: unexpected success");
}

fn bearer_of(resp: HttpClientResp) -> Result<string, string> {
    let doc = json_parse(http_bytes_to_text(resp.body)?)?;
    return Ok(json_as_string(json_object_get(doc, "token")?)?);
}

fn trace_has_name(names: Array<string>, want: string) -> bool {
    for n in names {
        if n == want {
            return true;
        } else {
        }
    }
    return false;
}

// Check one Jaeger /api/traces/{id} document: the trace exists,
// carries exactly the six demo spans by operation name, and links
// at least one child to its parent. Returns "found" or "wait"
// (keep polling); hard failures propagate.
fn trace_check_doc(doc: JsonVal, tid: string) -> Result<string, string> {
    let data = json_object_get(doc, "data")?;
    if json_array_len(data)? == 0 {
        return Ok("wait");
    } else {
    }
    let t0 = json_array_get(data, 0)?;
    if json_as_string(json_object_get(t0, "traceID")?)? != tid {
        return Ok("wait");
    } else {
    }
    let spans = json_object_get(t0, "spans")?;
    let names: Array<string> = [];
    let mut child_of: bool = false;
    let mut i: int = 0;
    let n: int = json_array_len(spans)?;
    while i < n {
        let s = json_array_get(spans, i)?;
        let nm = json_as_string(json_object_get(s, "operationName")?)?;
        push(names, nm);
        let refs = json_object_get(s, "references")?;
        let m: int = json_array_len(refs)?;
        let mut k: int = 0;
        while k < m {
            let r = json_array_get(refs, k)?;
            let rt = json_as_string(json_object_get(r, "refType")?)?;
            let ri = json_as_string(json_object_get(r, "traceID")?)?;
            if rt == "CHILD_OF" && ri == tid {
                child_of = true;
            } else {
            }
            k = k + 1;
        }
        i = i + 1;
    }
    if n != 6 {
        return Ok("wait");
    } else {
    }
    if !trace_has_name(names, "test-front-call") {
        return Ok("wait");
    } else {
    }
    if !trace_has_name(names, "GET /front/users/{id}") {
        return Ok("wait");
    } else {
    }
    if !trace_has_name(names, "front-to-data") {
        return Ok("wait");
    } else {
    }
    if !trace_has_name(names, "GET /users/{id}") {
        return Ok("wait");
    } else {
    }
    if !trace_has_name(names, "auth") {
        return Ok("wait");
    } else {
    }
    if !trace_has_name(names, "db") {
        return Ok("wait");
    } else {
    }
    if !child_of {
        return Ok("wait");
    } else {
    }
    return Ok("found");
}

fn trace_verify_jaeger(tid: string, copts: HttpClientOpts) -> Result<string, string> {
    let qb = env_or("TOTO_TEST_JAEGER_BASE", "http://127.0.0.1:16686");
    let mut i: int = 0;
    while i < 50 {
        let r = http_do(HttpClientReq { method: "GET", url: qb + "/api/traces/" + tid, headers: [], body: [], ca_pem: "" }, copts)?;
        if r.status == 200 {
            let doc = json_parse(http_bytes_to_text(r.body)?)?;
            if trace_check_doc(doc, tid)? == "found" {
                return Ok("trace-verified=yes");
            } else {
            }
        } else {
        }
        i = i + 1;
    }
    return Err("trace missing from collector");
}

fn run() -> Result<string, string> {
    log_set_sink("buffer")?;
    log_set_level("info")?;
    ctx_set_current(ctx_with_value(ctx_background(), "trace_id", "refsvc-data-1"))?;
    log_info("refsvc-data starting")?;
    let cfg = refsvc_config()?;
    let port = env_int("TOTO_REFSVC_PORT", refsvc_port(cfg)?)?;
    let dsn = env_or("TOTO_REFSVC_DSN", refsvc_dsn(cfg)?);
    let front_port = env_int("TOTO_REFSVC_FRONT_PORT", 48520)?;
    let ttl = refsvc_ttl(cfg)?;
    db_pool_config(dsn, 8, 5000)?;
    let pws = refsvc_setup(dsn, true)?;
    let key = crypto_random(32)?;
    let reg = metrics_registry();
    refsvc_register(reg)?;
    let tracer = trace_tracer();
    let router = http_router();
    let svc = RefsDat { dsn: dsn, key: key, ttl_ms: ttl, meter: true };
    refsvc_routes(router, svc, reg, tracer)?;
    let listener = refsvc_serve(port, router)?;
    let frouter = http_router();
    let data_base = "https://localhost:" + to_string(port);
    let copts = refsvc_client_opts();
    let ca = refsvc_ca();
    refsvc_front_routes(frouter, svc, tracer, data_base, ca, copts)?;
    let flistener = refsvc_serve_front(front_port, frouter)?;
    let base = "https://localhost:" + to_string(port);
    let front_base = "https://localhost:" + to_string(front_port);
    // Login ok (alice) + token capture.
    let r1 = post_login(base, ca, "alice", pws[0], copts)?;
    if r1.status != 200 {
        net_close(listener)?;
        return Err("login status");
    } else {
    }
    let tok = bearer_of(r1)?;
    println("login=200");
    // Wrong password and unknown user are the same 401.
    let r2 = post_login(base, ca, "alice", "pw-wrong", copts)?;
    if r2.status != 401 {
        net_close(listener)?;
        return Err("badlogin status");
    } else {
    }
    println("badlogin=401");
    let r3 = post_login(base, ca, "nosuch", "pw-wrong", copts)?;
    if r3.status != 401 {
        net_close(listener)?;
        return Err("nouser status");
    } else {
    }
    println("nouser-login=401");
    // No token, bad scheme, bad shape: 401 responses.
    let b0: Array<HttpHeader> = [];
    let u1 = http_do(HttpClientReq { method: "GET", url: base + "/users/alice", headers: b0, body: [], ca_pem: ca }, copts)?;
    if u1.status != 401 {
        net_close(listener)?;
        return Err("noauth status");
    } else {
    }
    println("noauth=401");
    let b1: Array<HttpHeader> = [HttpHeader { name: "Authorization", value: "Token " + tok }];
    let u2 = http_do(HttpClientReq { method: "GET", url: base + "/users/alice", headers: b1, body: [], ca_pem: ca }, copts)?;
    if u2.status != 401 {
        net_close(listener)?;
        return Err("badscheme status");
    } else {
    }
    println("badscheme=401");
    let b2: Array<HttpHeader> = [HttpHeader { name: "Authorization", value: "Bearer a.b" }];
    let u3 = http_do(HttpClientReq { method: "GET", url: base + "/users/alice", headers: b2, body: [], ca_pem: ca }, copts)?;
    if u3.status != 401 {
        net_close(listener)?;
        return Err("badshape status");
    } else {
    }
    println("badshape=401");
    // Forged signature: the handler `Err` aborts the connection
    // fail-closed (accepted v1 deviation) — the client must see
    // a transport failure, never a 200 and never a 500.
    // Forge by flipping the FIRST signature character (all six
    // bits significant — the old last-char flip was a silent no-op
    // whenever old and new shared the high nibble (e.g. A<->B
    // differ only in pad bits), letting the "forgery" verify ~1/16
    // of the time and flaking the golden).
    let tparts: Array<string> = split(tok, ".");
    let sig: string = tparts[2];
    let first: string = substring(sig, 0, 1);
    let rest: string = substring(sig, 1, len(sig));
    let mut new_first: string = "Q";
    if first == "Q" {
        new_first = "A";
    } else {
    }
    let forged = tparts[0] + "." + tparts[1] + "." + new_first + rest;
    let bf: Array<HttpHeader> = [HttpHeader { name: "Authorization", value: "Bearer " + forged }];
    let n = neg_probe(fn() -> Result<HttpClientResp, string> {
        return http_do(HttpClientReq { method: "GET", url: base + "/users/alice", headers: bf, body: [], ca_pem: ca }, copts);
    });
    let w_bad: Result<string, string> = Err("http: unexpected success");
    let mut fg = "aborted";
    if n == w_bad {
        fg = "BAD";
    } else {
    }
    println("forged=" + fg);
    // Expired token (valid signature, issued ttl+1ms ago by the
    // monotonic clock): 401, not abort. Deterministic: the clock
    // never runs backward, so now-iat only grows past ttl.
    let old_iat = clock_monotonic_ms() - ttl - 1;
    let old_tok = jwt_sign_hs256("{\"sub\":\"alice\",\"iat_ms\":" + to_string(old_iat) + ",\"ttl_ms\":" + to_string(ttl) + ",\"iss\":\"toto-refsvc\"}", key)?;
    let u4 = get_authed(base, ca, "/users/alice", old_tok, copts)?;
    if u4.status != 401 {
        net_close(listener)?;
        return Err("expired status");
    } else {
    }
    println("expired=401");
    // Authed read ok + unknown user 404.
    let u5 = get_authed(base, ca, "/users/alice", tok, copts)?;
    if u5.status != 200 {
        net_close(listener)?;
        return Err("user status");
    } else {
    }
    let uname = json_as_string(json_object_get(json_parse(http_bytes_to_text(u5.body)?)?, "name")?)?;
    println("user=200:" + uname);
    let u6 = get_authed(base, ca, "/users/nosuch", tok, copts)?;
    if u6.status != 404 {
        net_close(listener)?;
        return Err("404 status");
    } else {
    }
    println("nouser=404");
    // Authed writes + read-back.
    let nb = http_text_to_bytes("{\"body\":\"hello-1\"}")?;
    let hs: Array<HttpHeader> = [HttpHeader { name: "Authorization", value: "Bearer " + tok }];
    let w1 = http_do(HttpClientReq { method: "POST", url: base + "/notes", headers: hs, body: nb, ca_pem: ca }, copts)?;
    if w1.status != 200 {
        net_close(listener)?;
        return Err("notes post 1");
    } else {
    }
    let nb2 = http_text_to_bytes("{\"body\":\"hello-2\"}")?;
    let w2 = http_do(HttpClientReq { method: "POST", url: base + "/notes", headers: hs, body: nb2, ca_pem: ca }, copts)?;
    if w2.status != 200 {
        net_close(listener)?;
        return Err("notes post 2");
    } else {
    }
    let g = get_authed(base, ca, "/notes", tok, copts)?;
    if g.status != 200 {
        net_close(listener)?;
        return Err("notes get");
    } else {
    }
    let notes = json_parse(http_bytes_to_text(g.body)?)?;
    println("notes=200:" + to_string(json_array_len(notes)?));
    // Metrics: unauthed 401, authed scrape byte-matches local render.
    let m0 = http_do(HttpClientReq { method: "GET", url: base + "/metrics", headers: b0, body: [], ca_pem: ca }, copts)?;
    if m0.status != 401 {
        net_close(listener)?;
        return Err("metrics auth status");
    } else {
    }
    println("metrics-auth=401");
    let sc = get_authed(base, ca, "/metrics", tok, copts)?;
    if sc.status != 200 {
        net_close(listener)?;
        return Err("scrape status");
    } else {
    }
    let ct = http_header_get(sc.headers, "content-type")?;
    if ct != metrics_content_type() {
        net_close(listener)?;
        return Err("scrape content-type");
    } else {
    }
    let body = http_bytes_to_text(sc.body)?;
    let want = metrics_render(reg)?;
    if body != want {
        net_close(listener)?;
        return Err("scrape mismatch");
    } else {
    }
    println("metrics=200:match");
    print(body);
    // Traced cross-service demo: main starts the root client span,
    // the front service continues it across a go block, and the
    // data service continues it across the service boundary.
    let troot = trace_begin(tracer, ctx_background(), "test-front-call", "client", "refsvc-front")?;
    let tctx = trace_ctx(ctx_background(), troot);
    let tih = trace_inject(tctx)?;
    let ths: Array<HttpHeader> = [HttpHeader { name: "Authorization", value: "Bearer " + tok }, tih[0]];
    let tr = http_do(HttpClientReq { method: "GET", url: front_base + "/front/users/alice", headers: ths, body: [], ca_pem: ca }, copts)?;
    if tr.status != 200 {
        net_close(flistener)?;
        net_close(listener)?;
        return Err("traced front status");
    } else {
    }
    trace_end(tracer, troot.span, 1, "")?;
    println("front=200");
    println(trace_finished_report(tracer));
    let ep = env_or("TOTO_TEST_OTLP_BASE", "");
    if ep != "" {
        trace_export(tracer, ep)?;
        let tid = troot.span.trace_id;
        println("trace_id=" + tid);
        let v = trace_verify_jaeger(tid, copts)?;
        println(v);
        net_close(flistener)?;
        net_close(listener)?;
        if v != "trace-verified=yes" {
            return Err("trace verify");
        } else {
        }
        return Ok("REFSVC-DATA-OK");
    } else {
    }
    net_close(flistener)?;
    // Wrong CA: handshake fails; survival proven by the request after.
    let other_ca = refsvc_other_ca();
    let n2 = neg_probe(fn() -> Result<HttpClientResp, string> {
        return http_do(HttpClientReq { method: "GET", url: base + "/users/alice", headers: hs, body: [], ca_pem: other_ca }, copts);
    });
    let mut ng = "yes";
    if n2 == w_bad {
        ng = "BAD";
    } else {
    }
    println("neg=" + ng);
    let after = get_authed(base, ca, "/users/bob", tok, copts)?;
    if after.status != 200 {
        net_close(listener)?;
        return Err("after status");
    } else {
    }
    println("after=200");
    net_close(listener)?;
    let lines = log_drain_lines();
    for line in lines {
        println(strip_ts(line)?);
    }
    println("log-lines=" + to_string(len(lines)));
    return Ok("REFSVC-DATA-OK");
}

fn main() -> int {
    println(run());
    return 0;
}
