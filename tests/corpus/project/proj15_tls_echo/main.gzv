import "gzv.std/net.gzv";
import "gzv.std/tls.gzv";

// Wave 2 Stage 1 TLS loopback echo (Toto client <-> Toto server
// through the real `gzv.std/tls` wrappers): the server upgrades an
// accepted TCP fd with the pinned certificate/key fixtures, the
// client upgrades a connected TCP fd verifying against the pinned
// CA, and a 2-byte message round-trips. Interop against the
// reference (`openssl s_server`/`s_client`, both directions, plus
// the untrusted-peer negative) lives in the Rust integration tests
// (`crates/toto-compiler/tests/tls_interop.rs`,
// `crates/toto-runtime/tests/tls_openssl.rs`); this project proves
// the wrapper surface end to end with exact goldens.

fn tls_serve_inner(listener: int, cert: string, key: string) -> Result<string, string> {
    let conn = net_accept(listener)?;
    let tls = tls_server_accept(conn, cert, key)?;
    let data = tls_recv(tls, 16)?;
    let n = tls_send_all(tls, data)?;
    tls_close(tls)?;
    net_close(listener)?;
    if n == 2 {
        return Ok("TLS-SERVE-OK");
    }
    return Err("short tls echo");
}

fn tls_serve(listener: int, cert: string, key: string, out: chan<Result<string, string>>) -> int {
    out <- tls_serve_inner(listener, cert, key);
    return 0;
}

fn tls_client(port: int, ca: string) -> Result<string, string> {
    let conn = net_tcp_connect("localhost", port)?;
    let tls = tls_client_connect(conn, ca)?;
    let sent = tls_send_all(tls, [72, 105])?;
    let resp = tls_recv(tls, 16)?;
    tls_close(tls)?;
    if sent == 2 && len(resp) == 2 && resp[0] == 72 && resp[1] == 105 {
        return Ok("TLS-CLIENT-OK");
    }
    return Err("bad tls echo");
}

// Deterministic error paths (no peer needed): a closed fd names no
// TLS session, and `max < 1` is a value error — all loud `Err`s.
fn tls_errors() -> Result<string, string> {
    let s = net_tcp_listen(48412)?;
    net_close(s)?;
    let want_conn: Result<int, string> = Err("tls: not a TLS connection");
    if tls_close(s) != want_conn {
        return Err("tls_close on plain socket misreported");
    }
    if tls_send(s, [1]) != want_conn {
        return Err("tls_send on plain socket misreported");
    }
    let want_max: Result<Array<int>, string> = Err("invalid max (want >= 1)");
    if tls_recv(s, 0) != want_max {
        return Err("tls_recv max misreported");
    }
    return Ok("TLS-ERRORS-OK");
}

fn run_echo() -> Result<string, string> {
    let done = chan<Result<string, string>>(1);
    let listener = net_tcp_listen(48411)?;
    let cert = read_file("fixtures/server-cert.pem");
    let key = read_file("fixtures/server-key.pem");
    go {
        tls_serve(listener, cert, key, done);
    }
    let ca = read_file("fixtures/ca.pem");
    let cr = tls_client(48411, ca)?;
    println(<-done);
    return Ok(cr);
}

fn main() -> int {
    println(run_echo());
    println(tls_errors());
    return 0;
}
