# Toto Enterprise Wave 4 Stage 5 — refsvc reference-service image.
#
# The reference service is DB-backed, and AOT refuses blocking DB
# waits by design (recorded v1 limit) — so this image carries the
# release interpreter plus the service sources, not an AOT binary.
# Context (assembled host-side, see the wave report):
#   bin/toto      release `toto` binary
#   lib/*.so.*    toto's non-system closure (same allowlist as
#                 `toto dist`: everything except the glibc runtime)
#   src/          main.gzv + common.gzv + fixtures/ + toto.toml
# Base digest pinned at build time (2026-11-24). The interpreter
# has no baked rpath, so LD_LIBRARY_PATH points at the bundled
# lib/ (part of the artifact definition, set here — the app
# itself needs no env). TOTO_REFSVC_FIXDIR pins fixtures;
# TOTO_DRAIN_DIR pins the drain flag dir; the file DB + drain
# flag live in the writable WORKDIR. Loopback-only listeners
# (net_tcp_listen binds 127.0.0.1) serve the in-image client —
# all-interfaces bind is the carried Wave 0 follow-up, so a
# host-reachable daemon image is NOT this stage. Verify =
# container exit 0 + REFSVC-DATA-OK in the logs.
FROM ubuntu:26.04@sha256:d66b366dac61b575bee2aef07e9c26e8070096fbe84a3d4d3eb0da069b5d76db
COPY bin/ /app/bin/
COPY lib/ /app/lib/
COPY src/ /app/src/
ENV LD_LIBRARY_PATH=/app/lib
ENV TOTO_REFSVC_FIXDIR=/app/src/fixtures
ENV TOTO_DRAIN_DIR=/tmp/toto-drain
WORKDIR /app/work
RUN useradd -m -u 10001 app && mkdir -p /app/work /tmp/toto-drain && chown -R app:app /app/work /tmp/toto-drain
USER app
ENTRYPOINT ["/app/bin/toto", "run", "/app/src/main.gzv"]
