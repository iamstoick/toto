// bench/compute.gzv — pure arithmetic workload (no imports).
// Calibrated so the tree-walking interpreter takes ~1-3 s;
// every path must print exactly this checksum (asserted by
// scripts/bench.sh before timing).
fn main() -> int {
    let mut total = 0;
    let mut i = 0;
    while i < 1000000 {
        total = total + i * 3 - i / 2;
        i = i + 1;
    }
    println(total);
    return 0;
}
