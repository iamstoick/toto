  // %3: Result<int, string> (ok)
  // %4: unit (unit)
  // %5: string (const string)
  // %6: Result<int, string> (err)
  bb0:
    safepoint entry
    br %0 bb1 bb2
  bb1:
    %2 = const 1:int
    safepoint alloc
    %3 = wrap_ok %2
