  bb0:
    safepoint entry
    %0 = const 0:int
    %1 = copy %0
    %2 = const 0:int
    %3 = const 5:int
    %4 = copy %2
    jump bb1
  bb1:
    safepoint loop
    %5 = lt %4, %3
    br %5 bb2 bb4
  bb2:
    %6 = copy %4
    %7 = add %1, %6
    %1 = copy %7
    jump bb3
  bb3:
    %8 = satincr %4
    %9 = eq %8, %3
    %4 = copy %8
    br %9 bb4 bb1
  bb4:
    %10 = const 0:int
    %11 = copy %10
    jump bb5
  bb5:
    safepoint loop
    %12 = const 3:int
    %13 = lt %11, %12
    br %13 bb6 bb7
  bb6:
    %14 = const 1:int
    %15 = add %11, %14
    %11 = copy %15
    %16 = const 2:int
    %17 = eq %11, %16
    br %17 bb8 bb9
  bb7:
    %21 = const 7:int
    %22 = const 8:int
    safepoint alloc
    %23 = array [%21, %22]
    %24 = copy %23
    %25 = snapshot %24
    %26 = len %25
    %28 = const 0:int
    %27 = copy %28
    jump bb11
  bb8:
    jump bb5
  bb9:
    %19 = const ():unit
    %18 = copy %19
    jump bb10
  bb10:
    %20 = add %1, %11
    %1 = copy %20
    jump bb5
  bb11:
    safepoint loop
    %29 = lt %27, %26
    br %29 bb12 bb14
  bb12:
    %30 = index %25[%27]
    %31 = add %1, %30
    %1 = copy %31
    jump bb13
  bb13:
    %32 = const 1:int
    %33 = add %27, %32
    %27 = copy %33
    jump bb11
  bb14:
    safepoint call
    %34 = builtin println(%1)
    %35 = const 0:int
    ret %35
}
