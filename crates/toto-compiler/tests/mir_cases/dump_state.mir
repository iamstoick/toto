fn bump(by: int) -> int {
  // %0: int (by (param))
  // %1: int (count (state))
  // %2: int (bin)
  // %3: int (count (state))
  bb0:
    safepoint entry
    %1 = state_get #0
    %2 = add %1, %0
    state_set #0 = %2
    %3 = state_get #0
    ret %3
}

fn main() -> int {
  // %0: int (const int)
  // %1: chan<int> (ch (state chan))
  // %2: chan<int> (ch (state))
  // %3: int (const int)
  // %4: unit (send)
  // %5: unit (unit)
  // %6: chan<int> (ch (state))
  // %7: int (recv)
  // %8: int (v)
  // %9: fn(int) -> int (fn bump)
  // %10: int (call)
  // %11: int (println())
  // %12: int (const int)
  bb0:
    safepoint entry
    %0 = const 0:int
    state_set #0 = %0
    safepoint alloc
    %1 = channew int
    state_set #1 = %1
    %2 = state_get #1
    %3 = const 41:int
    safepoint park
    send %2 <- %3
    %5 = const ():unit
    %4 = copy %5
    %6 = state_get #1
    safepoint park
    %7 = recv %6
    %8 = copy %7
    %9 = funcref 0
    safepoint call
    %10 = call %9(%8)
    safepoint call
    %11 = builtin println(%10)
    %12 = const 0:int
    ret %12
}
